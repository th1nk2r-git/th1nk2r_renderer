#ifndef RESTIR_DI_SLANGH
#define RESTIR_DI_SLANGH

static const float RESTIR_PI = 3.14159265358979323846;
static const uint RESTIR_INVALID_LIGHT = 0xffffffffu;

struct RestirPointLight
{
    float4 position_range;
    float4 color_intensity;
    float4 radius;
};

// 32 bytes per pixel. Depth, normal/material, and linear view depth describe
// the producing pixel so the final buffer can validate temporal history.
struct RestirReservoir
{
    uint light_index;
    uint packed_uv;
    float weight;
    float target;
    uint sample_count;
    float depth;
    uint packed_normal_rm;
    float view_depth;
};

struct RestirSurface
{
    float3 position;
    float3 normal;
    float3 base_color;
    float roughness;
    float metallic;
    float depth;
    float4 normal_rm;
};

float2 restir_sign_not_zero(float2 value)
{
    return float2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0);
}

float3 restir_decode_octahedral(float2 encoded)
{
    float3 normal = float3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0)
    {
        normal.xy = (1.0 - abs(normal.yx)) * restir_sign_not_zero(normal.xy);
    }
    return normalize(normal);
}

uint restir_pack_uv(float2 uv)
{
    uint2 value = uint2(min(uv * 65536.0, 65535.0));
    return value.x | (value.y << 16u);
}

float2 restir_unpack_uv(uint packed)
{
    return (float2(packed & 0xffffu, packed >> 16u) + 0.5) / 65536.0;
}

uint restir_pack_normal_rm(float4 normal_rm)
{
    float4 normalized = saturate(float4(normal_rm.xy * 0.5 + 0.5, normal_rm.zw));
    uint4 bytes = uint4(round(normalized * 255.0));
    return bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u);
}

float4 restir_unpack_normal_rm(uint packed)
{
    float4 value = float4(
        packed & 0xffu,
        (packed >> 8u) & 0xffu,
        (packed >> 16u) & 0xffu,
        packed >> 24u
    ) / 255.0;
    return float4(value.xy * 2.0 - 1.0, value.zw);
}

float3 restir_reconstruct_position(
    float2 pixel_center,
    float depth,
    uint2 viewport,
    column_major matrix<float, 4, 4> inverse_view_projection)
{
    float2 ndc = pixel_center / float2(viewport) * 2.0 - 1.0;
    float4 world = mul(inverse_view_projection, float4(ndc, depth, 1.0));
    return world.xyz / world.w;
}

RestirReservoir restir_empty(float depth, float4 normal_rm)
{
    RestirReservoir reservoir;
    reservoir.light_index = RESTIR_INVALID_LIGHT;
    reservoir.packed_uv = 0u;
    reservoir.weight = 0.0;
    reservoir.target = 0.0;
    reservoir.sample_count = 0u;
    reservoir.depth = depth;
    reservoir.packed_normal_rm = restir_pack_normal_rm(normal_rm);
    reservoir.view_depth = 0.0;
    return reservoir;
}

uint restir_random_uint(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float restir_random_float(inout uint state)
{
    return float(restir_random_uint(state) & 0x00ffffffu) / 16777216.0;
}

uint restir_seed(uint2 pixel, uint frame_number, uint salt)
{
    uint state = pixel.x * 0x9e3779b9u ^ pixel.y * 0x85ebca6bu ^
        frame_number * 0xc2b2ae35u ^ salt;
    return restir_random_uint(state);
}

float3 restir_sample_position(RestirPointLight light, uint packed_uv)
{
    float2 uv = restir_unpack_uv(packed_uv);
    float z = 1.0 - 2.0 * uv.x;
    float azimuth = 2.0 * RESTIR_PI * uv.y;
    float radial = sqrt(max(1.0 - z * z, 0.0));
    float3 direction = float3(radial * cos(azimuth), radial * sin(azimuth), z);
    return light.position_range.xyz + max(light.radius.x, 0.0) * direction;
}

float3 restir_fresnel(float v_dot_h, float3 f0)
{
    return f0 + (1.0 - f0) * pow(1.0 - saturate(v_dot_h), 5.0);
}

float restir_ggx_g1(float n_dot_x, float alpha_squared)
{
    float denominator = n_dot_x + sqrt(
        alpha_squared + (1.0 - alpha_squared) * n_dot_x * n_dot_x
    );
    return 2.0 * n_dot_x / max(denominator, 1e-6);
}

float3 restir_brdf(RestirSurface surface, float3 view_direction, float3 light_direction)
{
    float3 half_vector = normalize(view_direction + light_direction);
    float n_dot_v = saturate(dot(surface.normal, view_direction));
    float n_dot_l = saturate(dot(surface.normal, light_direction));
    float n_dot_h = saturate(dot(surface.normal, half_vector));
    float v_dot_h = saturate(dot(view_direction, half_vector));
    float3 f0 = lerp(float3(0.04), surface.base_color, surface.metallic);
    float alpha = surface.roughness * surface.roughness;
    float alpha_squared = alpha * alpha;
    float denominator = n_dot_h * n_dot_h * (alpha_squared - 1.0) + 1.0;
    float distribution = alpha_squared /
        max(RESTIR_PI * denominator * denominator, 1e-7);
    float geometry = restir_ggx_g1(n_dot_v, alpha_squared) *
        restir_ggx_g1(n_dot_l, alpha_squared);
    float3 fresnel = restir_fresnel(v_dot_h, f0);
    float3 specular = distribution * geometry * fresnel /
        max(4.0 * n_dot_v * n_dot_l, 1e-6);
    float3 diffuse = (1.0 - fresnel) * (1.0 - surface.metallic) *
        surface.base_color / RESTIR_PI;
    return diffuse + specular;
}

float3 restir_contribution(
    RestirSurface surface,
    float3 camera_position,
    RestirPointLight light,
    uint packed_uv)
{
    float3 to_sample = restir_sample_position(light, packed_uv) - surface.position;
    float distance_squared = dot(to_sample, to_sample);
    float distance = sqrt(max(distance_squared, 1e-8));
    if (distance >= light.position_range.w)
    {
        return float3(0.0);
    }
    float3 light_direction = to_sample / distance;
    float3 view_direction = normalize(camera_position - surface.position);
    float n_dot_l = saturate(dot(surface.normal, light_direction));
    if (n_dot_l <= 0.0 || dot(surface.normal, view_direction) <= 0.0)
    {
        return float3(0.0);
    }
    float normalized_distance = distance / max(light.position_range.w, 1e-4);
    float range_falloff = saturate(1.0 - pow(normalized_distance, 4.0));
    float attenuation = range_falloff * range_falloff /
        max(distance_squared, 1e-4);
    return restir_brdf(surface, view_direction, light_direction) *
        light.color_intensity.rgb * light.color_intensity.w * attenuation * n_dot_l;
}

float restir_target(float3 contribution)
{
    return max(dot(max(contribution, 0.0), float3(0.2126, 0.7152, 0.0722)), 0.0);
}

void restir_add(
    inout RestirReservoir result,
    inout float weight_sum,
    uint light_index,
    uint packed_uv,
    float target,
    float weight,
    uint sample_count,
    inout uint random_state)
{
    result.sample_count += sample_count;
    weight_sum += weight;
    if (weight > 0.0 && restir_random_float(random_state) * weight_sum < weight)
    {
        result.light_index = light_index;
        result.packed_uv = packed_uv;
        result.target = target;
    }
}

void restir_finalize(inout RestirReservoir result, float weight_sum)
{
    result.weight = result.target > 0.0 && result.sample_count > 0u
        ? weight_sum / (float(result.sample_count) * result.target)
        : 0.0;
}

#endif
