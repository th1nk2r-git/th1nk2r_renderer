#ifndef RESTIR_DI_SLANGH
#define RESTIR_DI_SLANGH

static const float PI = 3.14159265358979323846;
static const uint INVALID_LIGHT = 0xffffffffu;

struct PointLight
{
    float4 position_range;
    float4 color_intensity;
    float4 radius;
};

// One sample per pixel, 32 bytes. Weight is normalized W, not the running sum.
// packed_normal_rm: octahedral normal (8+8 bits), roughness (8), metallic (8).
struct Reservoir
{
    uint light_index;
    uint packed_uv;
    float weight;
    float target;
    uint sample_count;
    float depth;
    uint packed_normal_rm;
    float view_depth;
};

struct Surface
{
    float3 position;
    float3 normal;
    float3 base_color;
    float roughness;
    float metallic;
};

struct Frame
{
    column_major matrix<float, 4, 4> inverse_view_projection;
    column_major matrix<float, 4, 4> view_projection;
    float4 camera_position;
    // Light count, viewport width/height, valid previous-frame reservoirs.
    uint4 light_count_viewport;
    // Frame sequence, initial candidates, spatial neighbors, radius in pixels.
    uint4 sampling;
    // X: maximum M accepted from temporal history.
    uint4 reuse_limits;
    // Relative depth difference, normal cosine, roughness/metallic differences.
    float4 rejection;
    // X: world-space shadow-ray bias.
    float4 visibility;
};

uint random_uint(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float random_float(inout uint state)
{
    return float(random_uint(state) >> 8u) * (1.0 / 16777216.0);
}

uint random_light(inout uint state, uint light_count)
{
    // Rejection avoids modulo bias for arbitrary light counts.
    uint threshold = (0u - light_count) % light_count;
    uint value;
    do
    {
        value = random_uint(state);
    }
    while (value < threshold);
    return value % light_count;
}

float3 reconstruct_position(float2 pixel_center, float depth, Frame frame)
{
    float2 ndc = pixel_center / float2(frame.light_count_viewport.yz) * 2.0 - 1.0;
    float4 world = mul(frame.inverse_view_projection, float4(ndc, depth, 1.0));
    return world.xyz / world.w;
}

float3 sample_position(PointLight light, uint packed_uv)
{
    float2 uv = (float2(packed_uv & 0xffffu, packed_uv >> 16u) + 0.5) / 65536.0;
    float z = 1.0 - 2.0 * uv.x;
    float angle = 2.0 * PI * uv.y;
    float radial = sqrt(max(1.0 - z * z, 0.0));
    return light.position_range.xyz + max(light.radius.x, 0.0) * float3(radial * cos(angle), radial * sin(angle), z);
}

float ggx_g1(float n_dot_x, float alpha_squared)
{
    float denominator = n_dot_x + sqrt(alpha_squared + (1.0 - alpha_squared) * n_dot_x * n_dot_x);
    return 2.0 * n_dot_x / max(denominator, 1e-6);
}

float3 brdf(Surface surface, float3 view_direction, float3 light_direction)
{
    float3 half_vector = normalize(view_direction + light_direction);
    float n_dot_v = saturate(dot(surface.normal, view_direction));
    float n_dot_l = saturate(dot(surface.normal, light_direction));
    float n_dot_h = saturate(dot(surface.normal, half_vector));
    float v_dot_h = saturate(dot(view_direction, half_vector));
    float3 f0 = lerp(float3(0.04), surface.base_color, surface.metallic);
    float alpha = surface.roughness * surface.roughness;
    float alpha_squared = alpha * alpha;
    float denominator = n_dot_h * n_dot_h * (alpha_squared - 1.0) + 1.0;
    float distribution = alpha_squared / max(PI * denominator * denominator, 1e-7);
    float geometry = ggx_g1(n_dot_v, alpha_squared) * ggx_g1(n_dot_l, alpha_squared);
    float3 fresnel = f0 + (1.0 - f0) * pow(1.0 - v_dot_h, 5.0);
    float3 specular = distribution * geometry * fresnel / max(4.0 * n_dot_v * n_dot_l, 1e-6);
    float3 diffuse = (1.0 - fresnel) * (1.0 - surface.metallic) * surface.base_color / PI;
    return diffuse + specular;
}

float3 contribution(Surface surface, float3 camera_position, PointLight light, uint packed_uv)
{
    // UV parametrizes a soft-shadow sphere offset, not an emitting-area measure.
    float3 to_sample = sample_position(light, packed_uv) - surface.position;
    float distance_squared = dot(to_sample, to_sample);
    float distance = sqrt(max(distance_squared, 1e-8));
    if (light.position_range.w <= 0.0 || distance >= light.position_range.w)
    {
        return float3(0.0);
    }
    float3 light_direction = to_sample / distance;
    float3 view_direction = normalize(camera_position - surface.position);
    float n_dot_l = saturate(dot(surface.normal, light_direction));
    if (n_dot_l <= 0.0 || dot(surface.normal, view_direction) <= 0.0)
    {
        return float3(0.0);
    }
    float normalized_distance = distance / light.position_range.w;
    float range_falloff = saturate(1.0 - pow(normalized_distance, 4.0));
    float attenuation = range_falloff * range_falloff / max(distance_squared, 1e-4);
    return brdf(surface, view_direction, light_direction) * light.color_intensity.rgb * light.color_intensity.w * attenuation * n_dot_l;
}

float target_pdf(Surface surface, Frame frame, PointLight light, uint packed_uv)
{
    float3 radiance = contribution(surface, frame.camera_position.xyz, light, packed_uv);
    float target = dot(max(radiance, 0.0), float3(0.2126, 0.7152, 0.0722));
    return isfinite(target) ? target : 0.0;
}

uint pack_normal_material(Surface surface)
{
    float3 normal = surface.normal / (abs(surface.normal.x) + abs(surface.normal.y) + abs(surface.normal.z));
    float2 oct = normal.xy;
    if (normal.z < 0.0)
    {
        oct = (1.0 - abs(oct.yx)) * float2(oct.x >= 0.0 ? 1.0 : -1.0, oct.y >= 0.0 ? 1.0 : -1.0);
    }
    uint2 packed_normal = uint2(round(saturate(oct * 0.5 + 0.5) * 255.0));
    uint roughness = uint(round(surface.roughness * 255.0));
    uint metallic = uint(round(surface.metallic * 255.0));
    return packed_normal.x | (packed_normal.y << 8u) | (roughness << 16u) | (metallic << 24u);
}

float3 unpack_normal(uint packed)
{
    float2 oct = float2(packed & 0xffu, (packed >> 8u) & 0xffu) / 255.0 * 2.0 - 1.0;
    float3 normal = float3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    float fold = max(-normal.z, 0.0);
    normal.xy += float2(normal.x >= 0.0 ? -fold : fold, normal.y >= 0.0 ? -fold : fold);
    return normalize(normal);
}

bool similar_surface(uint packed_normal_rm, float view_depth, Reservoir neighbor, float4 thresholds)
{
    if (neighbor.depth >= 1.0 || neighbor.view_depth <= 0.0 || !isfinite(neighbor.view_depth) || view_depth <= 0.0)
    {
        return false;
    }
    float roughness_delta = abs(float((packed_normal_rm >> 16u) & 0xffu) - float((neighbor.packed_normal_rm >> 16u) & 0xffu)) / 255.0;
    float metallic_delta = abs(float(packed_normal_rm >> 24u) - float(neighbor.packed_normal_rm >> 24u)) / 255.0;
    float normal_cosine = (packed_normal_rm & 0xffffu) == (neighbor.packed_normal_rm & 0xffffu)
        ? 1.0 : dot(unpack_normal(packed_normal_rm), unpack_normal(neighbor.packed_normal_rm));
    return abs(view_depth - neighbor.view_depth) <= thresholds.x * max(view_depth, neighbor.view_depth) &&
        normal_cosine >= thresholds.y && roughness_delta <= thresholds.z && metallic_delta <= thresholds.w;
}

void discard_sample(inout Reservoir reservoir)
{
    // Empty reservoirs retain M, including those rejected by visibility.
    reservoir.light_index = INVALID_LIGHT;
    reservoir.packed_uv = 0u;
    reservoir.weight = 0.0;
    reservoir.target = 0.0;
}

void update_reservoir(
    inout Reservoir reservoir, inout float weight_sum, uint light_index, uint packed_uv,
    float target, float weight, uint sample_count, float random)
{
    reservoir.sample_count += sample_count;
    if (weight <= 0.0 || !isfinite(weight))
    {
        return;
    }
    weight_sum += weight;
    if (random * weight_sum < weight)
    {
        reservoir.light_index = light_index;
        reservoir.packed_uv = packed_uv;
        reservoir.target = target;
    }
}

void normalize_reservoir(inout Reservoir reservoir, float weight_sum)
{
    if (reservoir.light_index == INVALID_LIGHT || reservoir.target <= 0.0 || reservoir.sample_count == 0u)
    {
        discard_sample(reservoir);
        return;
    }
    // Paper Algorithm 4: biased normalization, without support/MIS correction.
    reservoir.weight = weight_sum / float(reservoir.sample_count) / reservoir.target;
    if (!isfinite(reservoir.weight) || reservoir.weight <= 0.0)
    {
        discard_sample(reservoir);
    }
}

bool visible_to_sample(RaytracingAccelerationStructure tlas, Surface surface, PointLight light, uint packed_uv, float bias)
{
    float3 origin = surface.position + surface.normal * bias;
    float3 to_sample = sample_position(light, packed_uv) - origin;
    float distance = length(to_sample);
    if (distance <= 2.0 * bias)
    {
        return true;
    }
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = to_sample / distance;
    ray.TMin = bias;
    ray.TMax = distance - bias;
    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_FORCE_OPAQUE> query;
    query.TraceRayInline(tlas, RAY_FLAG_NONE, 0xff, ray);
    while (query.Proceed())
    {
    }
    return query.CommittedStatus() == COMMITTED_NOTHING;
}

#endif
