#ifndef GLOBAL_LIGHT_SLANGH
#define GLOBAL_LIGHT_SLANGH

static const float PI = 3.14159265358979323846;

struct Frame {
    column_major matrix<float, 4, 4> inverse_view_projection;
    float4 camera_position;
    uint4 viewport_samples_bounces;
    uint4 frame_light_roulette;
    float4 roulette_bias_distance;
};

struct Light {
    float4 position_range;
    float4 color_intensity;
    float4 radius;
};

struct RayInstance {
    float4 model_column_0;
    float4 model_column_1;
    float4 model_column_2;
    float4 normal_column_0;
    float4 normal_column_1;
    float4 normal_column_2;
    uint first_index;
    int vertex_offset;
    uint material_index;
    uint padding;
};

struct Material {
    float4 base_color_factor;
    float4 emissive_normal_scale;
    float4 metallic_roughness_occlusion_alpha_cutoff;
    uint4 flags;
    uint base_color_texture_index;
    uint metallic_roughness_texture_index;
    uint normal_texture_index;
    uint occlusion_texture_index;
    uint emissive_texture_index;
    uint padding_0;
    uint padding_1;
    uint padding_2;
};

struct Vertex {
    float3 position;
    float3 color;
    float2 texcoord;
    float3 normal;
    float4 tangent;
};

struct Surface {
    float3 position;
    float3 normal;
    float3 base_color;
    float3 emissive;
    float metallic;
    float roughness;
};

struct RadiancePayload {
    uint hit;
    uint instance_index;
    uint primitive_index;
    float2 barycentrics;
    float distance;
};

struct HitAttributes {
    float2 barycentrics : SV_Barycentrics;
};

[[vk::binding(0, 0)]] RaytracingAccelerationStructure scene_tlas;
[[vk::binding(1, 0)]] ConstantBuffer<Frame> frame;
[[vk::binding(2, 0)]] StructuredBuffer<Light> lights;
[[vk::binding(3, 0)]] StructuredBuffer<RayInstance> instances;
[[vk::binding(4, 0)]] Texture2D<float4> base_color_ao_texture;
[[vk::binding(5, 0)]] Texture2D<float4> normal_roughness_texture;
[[vk::binding(6, 0)]] Texture2D<float4> emissive_metallic_texture;
[[vk::binding(7, 0)]] Texture2D<float> depth_texture;
[[vk::binding(8, 0)]] [vk::image_format("rgba16f")] RWTexture2D<float4> diffuse_output;
[[vk::binding(9, 0)]] [vk::image_format("rgba16f")] RWTexture2D<float4> specular_output;

[[vk::binding(0, 1)]] ByteAddressBuffer vertices;
[[vk::binding(1, 1)]] ByteAddressBuffer indices;
[[vk::binding(2, 1)]] StructuredBuffer<Material> materials;
[[vk::binding(3, 1)]] SamplerState material_sampler;
[[vk::binding(4, 1)]] Texture2D<float4> textures[];

uint vertex_index(RayInstance instance, uint primitive, uint corner) {
    return indices.Load(4 * (instance.first_index + 3 * primitive + corner)) + instance.vertex_offset;
}

Vertex read_vertex(uint index) {
    uint offset = 60 * index;
    Vertex vertex;
    vertex.position = asfloat(vertices.Load3(offset));
    vertex.color = asfloat(vertices.Load3(offset + 12));
    vertex.texcoord = asfloat(vertices.Load2(offset + 24));
    vertex.normal = asfloat(vertices.Load3(offset + 32));
    vertex.tangent = asfloat(vertices.Load4(offset + 44));
    return vertex;
}

float3 transform_direction(RayInstance instance, float3 direction) {
    return instance.model_column_0.xyz * direction.x + instance.model_column_1.xyz * direction.y + instance.model_column_2.xyz * direction.z;
}

float3 transform_normal(RayInstance instance, float3 normal) {
    return instance.normal_column_0.xyz * normal.x + instance.normal_column_1.xyz * normal.y + instance.normal_column_2.xyz * normal.z;
}

float2 hit_texcoord(RayInstance instance, uint primitive, float2 barycentrics) {
    float2 uv0 = read_vertex(vertex_index(instance, primitive, 0)).texcoord;
    float2 uv1 = read_vertex(vertex_index(instance, primitive, 1)).texcoord;
    float2 uv2 = read_vertex(vertex_index(instance, primitive, 2)).texcoord;
    return uv0 * (1.0 - barycentrics.x - barycentrics.y) + uv1 * barycentrics.x + uv2 * barycentrics.y;
}

Surface hit_surface(RadiancePayload hit, float3 world_position) {
    RayInstance instance = instances[hit.instance_index];
    Material material = materials[instance.material_index];
    Vertex a = read_vertex(vertex_index(instance, hit.primitive_index, 0));
    Vertex b = read_vertex(vertex_index(instance, hit.primitive_index, 1));
    Vertex c = read_vertex(vertex_index(instance, hit.primitive_index, 2));
    float3 weights = float3(1.0 - hit.barycentrics.x - hit.barycentrics.y, hit.barycentrics.x, hit.barycentrics.y);
    float3 vertex_color = a.color * weights.x + b.color * weights.y + c.color * weights.z;
    float3 vertex_normal = a.normal * weights.x + b.normal * weights.y + c.normal * weights.z;
    float4 vertex_tangent = a.tangent * weights.x + b.tangent * weights.y + c.tangent * weights.z;
    float2 uv = a.texcoord * weights.x + b.texcoord * weights.y + c.texcoord * weights.z;
    float4 base = textures[NonUniformResourceIndex(material.base_color_texture_index)].SampleLevel(material_sampler, uv, 0);
    float4 mr = textures[NonUniformResourceIndex(material.metallic_roughness_texture_index)].SampleLevel(material_sampler, uv, 0);
    float3 tangent_normal = textures[NonUniformResourceIndex(material.normal_texture_index)].SampleLevel(material_sampler, uv, 0).xyz * 2.0 - 1.0;
    float3 emissive = textures[NonUniformResourceIndex(material.emissive_texture_index)].SampleLevel(material_sampler, uv, 0).rgb * material.emissive_normal_scale.xyz;
    float3 normal = normalize(transform_normal(instance, vertex_normal));
    float3 tangent = transform_direction(instance, vertex_tangent.xyz);
    tangent = normalize(tangent - normal * dot(normal, tangent));
    float3 bitangent = normalize(cross(normal, tangent)) * vertex_tangent.w;
    tangent_normal.xy *= material.emissive_normal_scale.w;
    tangent_normal = normalize(tangent_normal);
    Surface surface;
    surface.position = world_position;
    surface.normal = normalize(tangent * tangent_normal.x + bitangent * tangent_normal.y + normal * tangent_normal.z);
    surface.base_color = max(base.rgb * vertex_color * material.base_color_factor.rgb, 0.0);
    surface.emissive = max(emissive, 0.0);
    surface.metallic = saturate(mr.b * material.metallic_roughness_occlusion_alpha_cutoff.x);
    surface.roughness = clamp(mr.g * material.metallic_roughness_occlusion_alpha_cutoff.y, 0.045, 1.0);
    return surface;
}

void evaluate_brdf(Surface surface, float3 view_direction, float3 light_direction, out float3 diffuse, out float3 specular) {
    float n_dot_v = max(dot(surface.normal, view_direction), 0.0);
    float n_dot_l = max(dot(surface.normal, light_direction), 0.0);
    diffuse = 0.0;
    specular = 0.0;
    if (n_dot_v <= 0.0 || n_dot_l <= 0.0) return;
    float3 half_vector = normalize(view_direction + light_direction);
    float n_dot_h = max(dot(surface.normal, half_vector), 0.0);
    float v_dot_h = max(dot(view_direction, half_vector), 0.0);
    float alpha = surface.roughness * surface.roughness;
    float alpha2 = alpha * alpha;
    float d = n_dot_h * n_dot_h * (alpha2 - 1.0) + 1.0;
    float distribution = alpha2 / max(PI * d * d, 1e-7);
    float visibility = 0.5 / max(n_dot_l * sqrt(alpha2 + (1.0 - alpha2) * n_dot_v * n_dot_v) + n_dot_v * sqrt(alpha2 + (1.0 - alpha2) * n_dot_l * n_dot_l), 1e-7);
    float3 f0 = lerp(float3(0.04), surface.base_color, surface.metallic);
    float3 fresnel = f0 + (1.0 - f0) * pow(1.0 - v_dot_h, 5.0);
    diffuse = (1.0 - fresnel) * (1.0 - surface.metallic) * surface.base_color / PI;
    specular = distribution * visibility * fresnel;
}

#endif
